# Copy this into your deployment provider's Environment Variables.
# Never commit a real API key or put it in index.html.
ORACLE_API_KEY=
ORACLE_MODEL=gpt-4o-mini
# Optional: for an OpenAI-compatible provider, change this to its API root.
ORACLE_API_BASE_URL=https://api.openai.com/v1

# Optional account protection: configure these after setting up Supabase Auth.
# Set ORACLE_REQUIRE_AUTH=true to require a valid signed-in email session.
ORACLE_REQUIRE_AUTH=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
