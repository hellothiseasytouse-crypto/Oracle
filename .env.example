# Conversation AI keys (server-side only). Either use a single legacy key,
# or provide a comma/newline-separated list. Keys are tried in order and
# quota/rate-limit/auth failures trigger automatic failover to the next key.
ORACLE_API_KEYS=
ORACLE_API_KEY=
ORACLE_MODEL=openai/gpt-oss-120b
# Set this to https://api.groq.com/openai/v1 when using Groq keys.
ORACLE_API_BASE_URL=https://api.groq.com/openai/v1

# Separate title-only pool. These keys never generate chat replies.
ORACLE_NAMING_API_KEYS=
ORACLE_NAMING_API_KEY=
ORACLE_NAMING_MODEL=openai/gpt-oss-20b
ORACLE_NAMING_API_BASE_URL=https://api.groq.com/openai/v1

# Optional account protection for the chat endpoint.
ORACLE_REQUIRE_AUTH=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
